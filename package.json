{
  "name": "northstar-markets",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^5.18.0",
    "@mui/x-data-grid": "^7.29.13",
    "express": "^4.22.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "node scripts/dev.js",
    "start:client": "vite",
    "start:server": "node server/index.js",
    "serve": "NODE_ENV=production node server/index.js",
    "build": "vite build",
    "build:amplify": "npm run build && node scripts/buildAmplify.js",
    "refresh:scores": "node scripts/refreshPiotroskiScores.js",
    "test": "vitest run && npm run test:server",
    "test:server": "node --test server/*.test.js",
    "test:ui": "vitest"
  }

# Free public sources are the default and do not require a key.
MARKET_DATA_PROVIDER=public

# Optional: use "fmp" above only with a paid plan that includes the required endpoints.
# FMP_API_KEY=replace_with_your_server_side_key

# Optional cache controls (minutes)
MARKET_CACHE_MINUTES=15
MARKET_STALE_MINUTES=1440

# Zacks ranks are recalculated daily, so the server caches them separately.
ZACKS_CACHE_MINUTES=720
ZACKS_STALE_MINUTES=1440

# The weekly report is checked once per day. Set the edition URL if Zacks blocks redirects.
ZACKS_7_BEST_CACHE_MINUTES=1440
# ZACKS_7_BEST_EDITION_URL=https://www.zacks.com/registration/ultimatetrader/welcome/eoffer/3de3?edition=YYYYMMDD...

# Optional: enables 7-day, 30-day, and 1-year returns with three full-market requests per day.
# Sign up for the free Stocks Basic plan at https://massive.com/ and keep this server-side.
# MASSIVE_API_KEY=replace_with_your_server_side_key
MARKET_PERFORMANCE_CACHE_MINUTES=1440
MARKET_PERFORMANCE_STALE_MINUTES=10080
PORT=3001

# Free public sources are the default and do not require a key.
MARKET_DATA_PROVIDER=public

# Optional: use "fmp" above only with a paid plan that includes the required endpoints.
# FMP_API_KEY=replace_with_your_server_side_key

# Optional cache controls (minutes)
MARKET_CACHE_MINUTES=15
MARKET_STALE_MINUTES=1440
PORT=3001
